FILE_PREFIX=handbrake
RELEASE_TITLE="HandBrake"
DEFAULT_PORT=5800
HOMEPAGE_URL="https://github.com/jlesage/docker-handbrake"
CATEGORY=media
# Upstream jlesage/handbrake publishes a single-arch (linux/amd64) manifest —
# unlike jlesage/chromium and jlesage/firefox, which are multi-arch. An arm fpk
# would fail at `docker pull` with 'no matching manifest for linux/arm64/v8'.
# Restrict to x86 until upstream ships an arm64 manifest.
SUPPORTED_ARCH=x86

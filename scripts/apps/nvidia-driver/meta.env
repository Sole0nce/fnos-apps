FILE_PREFIX=nvidia-driver
RELEASE_TITLE="NVIDIA Driver"
DEFAULT_PORT=0
HOMEPAGE_URL="https://www.nvidia.com/drivers"
CATEGORY=system
SUPPORTED_ARCH=x86
# The package VERSION is the bundled nvidia-container-toolkit version.
# The NVIDIA driver version is NOT a build-time property any more: it is a
# runtime property of the user's fnOS image (fnOS ships prebuilt nvidia*.ko
# under /usr/lib/modules_trim/<kver>/), resolved by cmd/service-setup.
NCT_FALLBACK_VERSION="1.17.8"

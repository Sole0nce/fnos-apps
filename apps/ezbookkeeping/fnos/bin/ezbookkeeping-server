#!/bin/sh
APP_DIR="${TRIM_APPDEST}"
APP_DATA_DIR=$1
CONFIG_FILE="$APP_DATA_DIR/ezbookkeeping.ini"

# ezbookkeeping resolves log/, data/ and storage/ relative to its working
# directory, so it runs from the data dir; only the bundled static web files
# stay in the app dir.
mkdir -p "$APP_DATA_DIR/data" "$APP_DATA_DIR/log" "$APP_DATA_DIR/storage"

# Seed the upstream default config on first start. The app exits immediately
# when --conf-path does not exist and nothing else ever created it, so a fresh
# install could never start. Written only when absent, so user edits survive.
# Each key below is unique and line-anchored in the upstream ini.
if [ ! -f "$CONFIG_FILE" ]; then
    SECRET_KEY=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)
    sed -e "s|^http_port *=.*|http_port = ${TRIM_SERVICE_PORT:-8580}|" \
        -e "s|^static_root_path *=.*|static_root_path = ${APP_DIR}/public|" \
        -e "s|^secret_key *=.*|secret_key = ${SECRET_KEY}|" \
        "$APP_DIR/config/ezbookkeeping.ini" > "$CONFIG_FILE"
fi

cd "$APP_DATA_DIR" || exit 1
exec "$APP_DIR/ezbookkeeping" server run --conf-path "$CONFIG_FILE"

#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.log"
PID_FILE="${TRIM_PKGVAR}/${TRIM_APPNAME}.pid"

APP_DIR="${TRIM_APPDEST}"
APP_DATA_DIR="${TRIM_PKGVAR}"

SERVICE_COMMAND="$APP_DIR/bin/chinesesubfinder-server $APP_DATA_DIR"
SVC_BACKGROUND=y
SVC_WRITE_PID=y

service_preuninst() {
    # 兜底：确保 chinesesubfinder 进程被完全终止。
    # 必须用 -f 匹配绝对路径："chinesesubfinder" 有 16 个字符，超过内核 comm
    # 的 15 字符上限（实际进程名被截断成 "chinesesubfinde"），pkill -x 永远匹配
    # 不到，stop/uninstall 会漏掉进程。
    pkill -f "$APP_DIR/chinesesubfinder" 2>/dev/null || true  # pkill-f-ok
    sleep 1
    pkill -9 -f "$APP_DIR/chinesesubfinder" 2>/dev/null || true  # pkill-f-ok
}

service_poststop() {
    service_preuninst
}

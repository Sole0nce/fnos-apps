[
    {
        "stepTitle": "Arcane 设置",
        "items": [
            {
                "type": "tips",
                "helpText": "Arcane 是现代化的 Docker 管理面板，需要挂载 <code>/var/run/docker.sock</code> 以管理本机容器。<br>以下两个密钥为<b>必填项</b>，用于加密存储敏感数据与签发登录令牌，请使用足够随机的字符串（可在终端执行 <code>openssl rand -base64 32</code> 生成）。"
            },
            {
                "type": "text",
                "field": "wizard_port",
                "label": "Web UI 端口",
                "initValue": "3552",
                "rules": [
                    { "required": true, "message": "请输入端口号" },
                    { "pattern": "^[0-9]+$", "message": "端口必须是数字" }
                ]
            },
            {
                "type": "password",
                "field": "wizard_encryption_key",
                "label": "加密密钥（ENCRYPTION_KEY）",
                "placeholder": "至少 32 位随机字符",
                "rules": [
                    { "required": true, "message": "请设置加密密钥" },
                    { "min": 32, "message": "加密密钥至少 32 位（Arcane 要求）" }
                ]
            },
            {
                "type": "password",
                "field": "wizard_jwt_secret",
                "label": "JWT 密钥（JWT_SECRET）",
                "placeholder": "至少 32 位随机字符",
                "rules": [
                    { "required": true, "message": "请设置 JWT 密钥" },
                    { "min": 32, "message": "JWT 密钥至少 32 位（Arcane 要求）" }
                ]
            },
            {
                "type": "text",
                "field": "wizard_app_url",
                "label": "访问地址（APP_URL，可选）",
                "placeholder": "http://your-nas-ip:3552",
                "initValue": ""
            }
        ]
    }
]

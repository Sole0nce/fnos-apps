#!/bin/bash
# WG-Easy Docker app — wizard integration
#
# NOTE: wizard answers reach the container through compose substitution in
# docker-compose.yaml (${wizard_password} / ${wizard_wg_host}), NOT from here.
# Patching the compose in service_postinst cannot work: fnOS creates the
# container BEFORE install_callback runs, so the edit lands on disk only
# (AGENTS.md pitfall #3). apply_port below is kept for the post-install config
# wizard, which is a different flow.

COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"
PORT_SAVE="${TRIM_PKGVAR}/.port"

apply_port() {
    local port="$1"
    [ -z "$port" ] && return
    sed -i 's/"[^"]*:51821"/"'"${port}"':51821"/' "$COMPOSE_FILE"
    echo "${port}" > "$PORT_SAVE"
    install_log "Patched docker-compose.yaml: port=${port}"
}

# apply_wg_host / apply_password_hash were removed: they sed-patched
# WG_HOST / PASSWORD_HASH after the container already existed, so the values
# never reached it, and both names are v14 leftovers that wg-easy 15 ignores.

service_postinst() {
    mkdir -p "${TRIM_PKGVAR}/config" 2>/dev/null || true
}

service_postupgrade() {
    if [ -f "$PORT_SAVE" ]; then
        apply_port "$(cat "$PORT_SAVE")"
    fi
}

service_postconfig() {
    if [ -n "${wizard_port:-}" ]; then
        apply_port "${wizard_port}"
    fi
}
